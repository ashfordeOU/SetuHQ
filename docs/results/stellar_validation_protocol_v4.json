  "definitions": {
   "eb_candidate": "the module's eb_candidate flag",
   "period_match": "|P_ours / P_cat - 1| <= 0.005",
   "alias": "P_ours / P_cat within 0.5% of 0.5 or 2 (reported, not a match)",
   "depth": "primary eclipse depth, 1 - (eclipse minimum of the binned phase curve) / (out-of-eclipse level), compared with Dp-2g",
   "secondary_phase": "(phase of the secondary - phase of the primary) mod 1, compared with (Phis-2g - Phip-2g) mod 1 by the circular difference",
   "width": "primary eclipse width in phase units (the module's definition), compared with Wp-2g by rank correlation because the definitions differ",
   "morphology": "the module's class 'detached' against Morph < 0.5; any other class against Morph >= 0.5"
  },
