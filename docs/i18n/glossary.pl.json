{
 "lang": "pl",
 "about": "Fixed terms for this language (docs/TRANSLATING.md). 'en' is the English pattern; a translation of a message that has it must match 'target' (case-insensitive). 'keep' are written exactly as in English. 'claims': this language's words for discover and confirm, which a translation may use only where the English does.",
 "keep": [
  "SetuHQ",
  "Sentinels",
  "Sentinel",
  "Probes",
  "Probe",
  "TOI",
  "TESS",
  "CHEOPS",
  "ESA",
  "NASA",
  "MAST",
  "Claude",
  "Anthropic",
  "MCP"
 ],
