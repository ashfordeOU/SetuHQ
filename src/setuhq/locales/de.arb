 },
 "pg.0226495e68": "Dies war <a href=\"/candidates/wasp-126/dip-1/\">WASP-{n0}, Einbruch {n1} ({n2} d)</a>. Panel-Bewertung {n3}, markiert von {n4} Gutachtern. Nur Probes; Sentinels wurden für dieses Beispiel nicht ausgeführt.",
 "@pg.0226495e68": {
  "x-review": "machine",
  "x-source": "0226495e68"
 },
 "pg.02398cd55e": "SetuHQ misst den Zeitpunkt jedes Einbruchs und vergleicht die ungeraden und geraden Einbrüche miteinander; es fittet keine Timing-Variationen, Phasenkurven oder Bedeckungen. Die Tiefe der Sekundärbedeckung ist auf der Zeichenfläche zehnfach vergrößert dargestellt und so gekennzeichnet; die TTV-Amplitude ist illustrativ. Spin-Bahn-Winkel reichen von ausgerichteten über polare bis zu retrograden Bahnen (Albrecht et al. {n0}).",
 "@pg.02398cd55e": {
  "x-review": "machine",
  "x-source": "02398cd55e"
 },
 "pg.023e1f7bf3": "WASP-{n0} b: photochemisches SO₂ (<a href=\"https://doi.org/10.1038/s41586-023-05902-2\" rel=\"noopener\">Tsai et al. {n1}</a>)",
 "@pg.023e1f7bf3": {
  "x-review": "machine",
  "x-source": "023e1f7bf3"
 },
 "pg.026f23e525": "pi Men in seiner Schwarzkörperfarbe, {n0} K (TESS Input Catalog v8.2 (MAST))",
 "@pg.026f23e525": {
