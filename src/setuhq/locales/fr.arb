 },
 "pg.0226495e68": "Il s'agissait de <a href=\"/candidates/wasp-126/dip-1/\">WASP-{n0}, creux {n1} ({n2} d)</a>. Score du panel {n3}, marqué par {n4} évaluateurs. Probes uniquement ; Sentinels non exécutés sur cet exemple.",
 "@pg.0226495e68": {
  "x-review": "machine",
  "x-source": "0226495e68"
 },
 "pg.02398cd55e": "SetuHQ mesure l'instant de chaque creux et compare les creux pairs et impairs entre eux ; il n'ajuste pas les variations de chronométrage, les courbes de phase ni les éclipses. La profondeur de l'éclipse secondaire sur le canevas est dessinée dix fois plus profonde, et c'est indiqué ; l'amplitude des TTV est illustrative. Les angles spin–orbite couvrent des orbites alignées, polaires et rétrogrades (Albrecht et al. {n0}).",
 "@pg.02398cd55e": {
  "x-review": "machine",
  "x-source": "02398cd55e"
 },
 "pg.023e1f7bf3": "WASP-{n0} b : SO₂ photochimique (<a href=\"https://doi.org/10.1038/s41586-023-05902-2\" rel=\"noopener\">Tsai et al. {n1}</a>)",
 "@pg.023e1f7bf3": {
  "x-review": "machine",
  "x-source": "023e1f7bf3"
 },
