 },
 "pg.0226495e68": "Detta var <a href=\"/candidates/wasp-126/dip-1/\">WASP-{n0}, dipp {n1} ({n2} d)</a>. Panelpoäng {n3}, markerad av {n4} granskare. Endast Probes; Sentinels kördes inte på detta exempel.",
 "@pg.0226495e68": {
  "x-review": "machine",
  "x-source": "0226495e68"
 },
 "pg.02398cd55e": "SetuHQ mäter tidpunkten för varje dipp och jämför udda och jämna dippar med varandra; programmet anpassar inte tidsvariationer, faskurvor eller förmörkelser. Den sekundära förmörkelsens djup på duken ritas tio gånger djupare, vilket anges; TTV-amplituden är illustrativ. Spinn–omloppsvinklar spänner över inriktade, polära och retrograda banor (Albrecht et al. {n0}).",
 "@pg.02398cd55e": {
  "x-review": "machine",
  "x-source": "02398cd55e"
 },
 "pg.023e1f7bf3": "WASP-{n0} b: fotokemisk SO₂ (<a href=\"https://doi.org/10.1038/s41586-023-05902-2\" rel=\"noopener\">Tsai et al. {n1}</a>)",
 "@pg.023e1f7bf3": {
